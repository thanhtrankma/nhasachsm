# ---- Supabase (Project Settings → API Keys) ----
SUPABASE_URL=https://xxxx.supabase.co
# Secret key: chỉ dùng phía server (Vercel env), KHÔNG commit, KHÔNG đưa vào HTML/JS phía trình duyệt
SUPABASE_SECRET_KEY=sb_secret_xxx
# Bucket lưu ảnh upload (tạo sẵn bởi supabase/schema.sql)
SUPABASE_STORAGE_BUCKET=media

# ---- Đăng nhập trang quản trị /admin ----
ADMIN_PASSWORD=doi-mat-khau-nay
# Chuỗi ngẫu nhiên dài để ký cookie đăng nhập (vd: openssl rand -base64 32)
AUTH_SECRET=
